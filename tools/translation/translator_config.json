{
  "translators": {
    "openai": {
      "name": "OpenAI GPT",
      "description": "使用 OpenAI GPT 模型进行翻译，质量高但需要API密钥",
      "requires_api_key": true,
      "env_vars": ["OPENAI_API_KEY"],
      "optional_env_vars": ["OPENAI_MODEL"],
      "rate_limit": 1.0,
      "cost": "medium",
      "quality": "high"
    },
    "deepl": {
      "name": "DeepL",
      "description": "使用 DeepL 翻译服务，翻译质量极高",
      "requires_api_key": false,
      "base_url": "https://deepl.borber.top",
      "env_vars": [],
      "optional_env_vars": ["DEEPL_API_URL"],
      "rate_limit": 0.5,
      "cost": "free",
      "quality": "very_high"
    },
    "baidu": {
      "name": "百度翻译",
      "description": "百度翻译API，对中文支持较好",
      "requires_api_key": true,
      "env_vars": ["BAIDU_APP_ID", "BAIDU_SECRET_KEY"],
      "rate_limit": 0.2,
      "cost": "low",
      "quality": "medium"
    },
    "google": {
      "name": "谷歌翻译",
      "description": "谷歌翻译免费API，支持多种语言",
      "requires_api_key": false,
      "env_vars": [],
      "rate_limit": 0.3,
      "cost": "free",
      "quality": "medium"
    },
    "dictionary": {
      "name": "本地字典",
      "description": "使用内置翻译字典，速度快但覆盖有限",
      "requires_api_key": false,
      "env_vars": [],
      "rate_limit": 0,
      "cost": "free",
      "quality": "high_for_common_terms"
    }
  },
